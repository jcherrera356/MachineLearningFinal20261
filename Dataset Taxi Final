 x: abs(x[1]), reverse=True):\n","    print(f\"    {col:<40} : {coef:.4f}\")\n","\n","# ------------------------------------------------------------------------------\n","# 4.2 MODELO 2: ARBOL DE DECISION\n","# ------------------------------------------------------------------------------\n","print(\"\\n4.2 ARBOL DE DECISION\\n\")\n","\n","modelo_ad = DecisionTreeRegressor(max_depth=6, random_state=42)\n","modelo_ad.fit(X_train, y_train)\n","\n","print(\"  Modelo entrenado exitosamente.\")\n","print(f\"  Profundidad maxima configurada : 6\")\n","print(f\"  Profundidad real del arbol     : {modelo_ad.get_depth()}\")\n","print(f\"  Numero de hojas                : {modelo_ad.get_n_leaves()}\")\n","print()\n","print(\"  Importancia de variables (top 5):\")\n","importancias = sorted(zip(X_train.columns, modelo_ad.feature_importances_),\n","                      key=lambda x: x[1], reverse=True)\n","for col, imp in importancias[:5]:\n","    print(f\"    {col:<40} : {imp:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3mcvHnRO46bW","executionInfo":{"status":"ok","timestamp":1779423254840,"user_tz":300,"elapsed":24,"user":{"displayName":"JUAN CAMILO HERRERA OSORIO","userId":"01740464591269688400"}},"outputId":"c08ba5f5-c22b-4f24-ca18-ead7620c76d6"},"execution_count":139,"outputs":[{"output_type":"stream","name":"stdout","text":["==========================================================================================\n","FASE 4: MODELING\n","------------------------------------------------------------------------------------------\n","\n","4.1 REGRESION LINEAL\n","\n","  Modelo entrenado exitosamente.\n","  Intercepto (b0)    : 19.3187\n","\n","  Coeficientes por variable:\n","    municipio_destino_Staten Island          : -12.9029\n","    distancia                                : 9.9917\n","    municipio_destino_Queens                 : -4.7761\n","    municipio_destino_Manhattan              : -4.7314\n","    municipio_destino_Brooklyn       