IQR\n","    lim_sup = Q3 + 1.5 * IQR\n","    atipicos = data[(data[columna] < lim_inf) | (data[columna] > lim_sup)]\n","    return len(atipicos), lim_inf, lim_sup\n","\n","atipicos_dist, min_dist, max_dist = detectar_atipicos(df, 'distancia')\n","atipicos_tar,  min_tar,  max_tar  = detectar_atipicos(df, 'tarifa')\n","negativos_tar = len(df[df['tarifa'] < 0])\n","\n","print(\"Variable: distancia\")\n","print(f\"  Rango valido (IQR) : [{min_dist:.2f}, {max_dist:.2f}] millas\")\n","print(f\"  Rango real         : [{df['distancia'].min():.2f}, {df['distancia'].max():.2f}] millas\")\n","print(f\"  Atipicos detectados: {atipicos_dist} ({(atipicos_dist/len(df))*100:.2f}%)\")\n","print(f\"  Decision           : RETENER (viajes largos son validos en NYC)\")\n","print()\n","print(\"Variable: tarifa\")\n","print(f\"  Rango valido (IQR) : [{min_tar:.2f}, {max_tar:.2f}] USD\")\n","print(f\"  Rango real         : [{df['tarifa'].min():.2f}, {df['tarifa'].max():.2f}] USD\")\n","print(f\"  Atipicos detectados: {atipicos_tar} ({(atipicos_tar/len(df))*100:.2f}%)\")\n","print(f\"  Registros tarifa < 0: {negativos_tar}\")\n","print(f\"  Decision           : ELIMINAR registros con tarifa negativa (errores de entrada)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kE-b5HPpQKqF","executionInfo":{"status":"ok","timestamp":1779422998462,"user_tz":300,"elapsed":49,"user":{"displayName":"JUAN CAMILO HERRERA OSORIO","userId":"01740464591269688400"}},"outputId":"b3f764ae-f861-4073-ebb4-219dd69cac95"},"execution_count":119,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","2.4 DETECCION DE VALORES ATIPICOS (Metodo IQR)\n","\n","Variable: distancia\n","  Rango valido (IQR) : [-2.36, 6.55] millas\n","  Rango real         : [0.00, 36.70] millas\n","  Atipicos detectados: 734 (11.41%)\n","  Decision           : RETENER (viajes largos son validos en NYC)\n","\n","Variable: tarifa\n","  Rango valido (IQR) : [-6.25, 27.75] USD\n","  Rango real         : [1.00, 150.00] USD\n","  Atipicos detectados: 592 (9.20%)\n","  Registros tarifa < 0: 0\n","  Decision           : ELIMINAR registros con tarifa negativa (errores de entrada)\n"]}]},{"cell_type":"markdown","source":["### 2.4.1 Distribucion de la Variable Objetivo\n","\n","La variable `tarifa` presenta una distribucion con **sesgo positivo**, lo que\n","significa que la mayoria de viajes tienen tarifas bajas pero existe una cola\n","de viajes costosos.\n","\n","Esto es esperado en datos de taxi reales:\n","- La mayoria de viajes son cortos y economicos (dentro de Manhattan)\n","- Una minoria corresponde a viajes largos (aeropuertos, otros boroughs)\n","\n","Se conservan los valores altos ya que representan viajes validos.\n","En el Entregable 2 se evaluara aplicar transformacion logaritmica sobre\n","`tarifa` si los residuales del modelo no son normales."],"metadata":{"id":"GlPyFYQxrZru"}},{"cell_type":"code","source":["print(\"\\n2.4.1 DISTRIBUCION DE LA VARIABLE OBJETIVO (tarifa)\\n\")\n","\n","q1   = df['tarifa'].quantile(0.25)\n","q3   = df['tarifa'].quantile(0.75)\n","p95  = df['tarifa'].quantile(0.95)\n","skew = df['tarifa'].skew()\n","\n","print(f\"  Media        : ${df['tarifa'].mean():.2f}\")\n","print(f\"  Mediana      : ${df['tarifa'].median():.2f}\")\n","print(f\"  Q1 / Q3      : ${q1:.2f} / ${q3:.2f}\")\n","print(f\"  Percentil 95 : ${p95:.2f}\")\n","print(f\"  Sesgo        : {skew:.3f}\")\n","print()\n","if skew > 1:\n","    print(\"  Distribucion con sesgo positivo alto.\")\n","    print(f\"  El 95% de las tarifas esta por debajo de ${p95:.2f}.\")\n","    print(\"  Existe una cola de viajes costosos (aeropuertos, viajes largos).\")\n","    print(\"  Decision: se conservan — son valores validos en NYC.\")\n","    print(\"  Nota: se evaluara transformacion logaritmica en Entregable 2.\")\n","else:\n","    print(\"  Distribucion aproximadamente simetrica.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"T3IVhC8mro7O","executionInfo":{"status":"ok"