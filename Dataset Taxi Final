ago', 'municipio_recogida', 'municipio_destino']:\n","    print(f\"    - {var}: {df_prep[var].nunique()} categorias\")\n","\n","# 3.4 Extraccion temporal\n","print(\"\\n3.4 EXTRACCION DE CARACTERISTICAS TEMPORALES\\n\")\n","print(f\"    - hora            : rango {df_prep['hora'].min()}-{df_prep['hora'].max()}\")\n","print(f\"    - es_fin_semana   : {df_prep['es_fin_semana'].value_counts().to_dict()}\")\n","\n","# 3.5 Eliminacion de colineales\n","print(\"\\n3.5 ELIMINACION DE VARIABLES COLINEALES\\n\")\n","print(\"  'fecha_destino' -> ELIMINAR (correlacionada con 'fecha_recogida')\")\n","print(\"  'total'         -> ELIMINAR (data leakage: total = tarifa + propina + peajes)\")\n","print(\"  'fecha_recogida'-> ELIMINAR (features temporales ya extraidas)\")\n","print(\"  'dia_semana'    -> ELIMINAR (informacion capturada por 'es_fin_semana')\")\n","print(\"  'rango_distancia'-> ELIMINAR (variable auxiliar de visualizacion)\")\n","df_prep.drop(['fecha_destino', 'total', 'fecha_recogida', 'dia_semana', 'rango_distancia'],\n","             axis=1, inplace=True)\n","\n","# 3.6 Resumen final\n","print(\"\\n3.6 RESUMEN FINAL DEL DATASET PREPROCESADO (Parte I)\\n\")\n","print(f\"  Registros : {df_prep.shape[0]:,}\")\n","print(f\"  Variables : {df_prep.shape[1]}\")\n","print(f\"  Columnas  : {df_prep.columns.tolist()}\")\n","print()\n","print(\"Estadisticas descriptivas (variables numericas):\")\n","print(df_prep.describe().round(2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-mQbt6ZsR3Ol","executionInfo":{"status":"ok","timestamp":1779423005091,"user_tz":300,"elapsed":3,"user":{"displayName":"JUAN CAMILO HERRERA OSORIO","userId":"01740464591269688400"}},"outputId":"541cf7d9-6b81-474f-e9d0-303753f12a59"},"execution_count":127,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","==========================================================================================\n","FASE 3: DATA PREPARATION (Parte I)\n","-------------------------------